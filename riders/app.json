{
  "expo": {
    "name": "Vendo Rider",
    "slug": "vendo-rider",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vendorider",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.vendoltd.rider",
      "supportsTablet": false
    },
    "android": {
      "package": "com.vendoltd.rider",
      "adaptiveIcon": {
        "backgroundColor": "#0A1633",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1633",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Vendo Rider uses your location, including in the background while you are online, to send you nearby deliveries and show customers where their order is.",
          "locationWhenInUsePermission": "Vendo Rider uses your location to send you nearby deliveries and show customers where their order is.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vendo Rider needs your photos so you can upload your ID and vehicle documents.",
          "cameraPermission": "Vendo Rider needs your camera so you can photograph your ID and vehicle documents."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0064FF",
          "defaultChannel": "offers"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e5fa753d-2ac8-47c2-9225-7db05144eebe"
      }
    },
    "owner": "motaavendo"
  }
}
