# Copy to .env. Health and OpenAPI run without providers in development.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
# Set to the exact trusted reverse-proxy address/CIDR when deployed. Never use '*'.
TRUST_PROXY=

# Supabase phone authentication (public anon or publishable key; not service role).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase Postgres pooler URL. Use TLS for hosted connections.
DATABASE_URL=
DATABASE_SSL=verify
# Optional CA bundle path if your database uses a private certificate authority.
DATABASE_CA_PATH=

# Redis is required in production for rate limits shared across API instances.
REDIS_URL=

# Supabase Send SMS HTTP hook. Configure the endpoint and secret in Supabase.
SEND_SMS_HOOK_SECRET=

# Brevo transactional API key (not an SMTP key).
BREVO_API_KEY=
# Approved SMS sender: up to 11 alphanumeric characters or 15 digits.
BREVO_SMS_SENDER=Vendo
# Verified sender/domain configured in Brevo. Do not use an unverified address.
BREVO_EMAIL_SENDER=
BREVO_EMAIL_SENDER_NAME=Vendo
# Random server-only secret (at least 32 characters) for hashing email codes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_VERIFICATION_SECRET=

# Server-only Mapbox token for Food Court delivery quotes
MAPBOX_ACCESS_TOKEN_SERVER=

# At least 32 random characters; keep stable to decrypt existing dispatch delivery codes
DISPATCH_DELIVERY_CODE_SECRET=

# Configured Photon instance (no default public demo traffic)
PHOTON_BASE_URL=

# Paystack secret is server-only. Start with a test key.
PAYSTACK_SECRET_KEY=
# Optional HTTPS return URL; redirects never confirm payment.
PAYSTACK_CALLBACK_URL=

# Optional FCM HTTP v1 push delivery (all three required together).
# Store service-account credentials server-side only; literal \n in PEM is supported.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
NOTIFICATION_REMINDER_MINUTES=30

# Optional Brevo utility template with MESSAGE attribute, approved by WhatsApp.
BREVO_WHATSAPP_SENDER=
BREVO_WHATSAPP_TEMPLATE_ID=

# Public customer-support contacts; leave blank until confirmed by the business.
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Legacy rider-document AES-GCM key; retain to read existing database documents.
RIDER_DOCUMENT_SECRET=
# Transfers require business-approved rules, reviewed recipients, Paystack setup and staging checks.
PAYSTACK_TRANSFERS_ENABLED=false
# Separate workers are recommended in production: matching, orders, payments, notifications, finance.
WORKER_KIND=all
# Operator-only pg_dump/pg_restore settings. Generate and store a 32-byte base64 key securely.
BACKUP_ENCRYPTION_KEY=
RESTORE_DATABASE_URL=

# Server-only Supabase Storage credential. NEVER use in mobile/web env files.
# Buckets are provisioned explicitly with npm run storage:setup.
SUPABASE_SERVICE_ROLE_KEY=
